{
  "name": "Claude Skills — prompt context watch",
  "description": "Managed by Claude Skills Manager (claude-skills-prompt-context)",
  "version": "1",
  "enabled": true,
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/prompt-context?agent=kiro&cwd=d%3A%5CAI_Research_Agent\" || true",
    "timeout": 8
  }
}

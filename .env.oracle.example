# Copy to .env on the Oracle VM. Do not commit .env.
# Replace DOMAIN, ACME_EMAIL, AGENT_SHARED_KEY.

DOMAIN=yourname.io.vn
ACME_EMAIL=you@example.com

# Hosted model keys — visitors pick Gemini / OpenAI / Grok; these are used until credits run out.
# Multiple keys for one provider: key-one;key-two (failover if the first is down or out of credits)
LLM_BYOK_REQUIRED=false
GOOGLE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=text-embedding-004

AUTH_MODE=dev
ALLOW_DEV_AUTH=true
VITE_AUTH_MODE=dev
# Empty = browser calls same origin (/v1 via nginx). Do not set this to the API container.
VITE_API_URL=
CORS_ORIGINS=https://yourname.io.vn

# openssl rand -hex 32
AGENT_SHARED_KEY=
API_TO_AGENT_KEY=

TAVILY_API_KEY=

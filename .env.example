# --- LLM ---
# Hosted keys: visitors pick Gemini / OpenAI / Grok. If credits run out they paste their own.
# Visitor keys are never written to Postgres. LLM_BYOK_REQUIRED=true forces visitor keys always.
LLM_BYOK_REQUIRED=false
# Multiple keys for one provider: key-one;key-two (failover if the first is down or out of credits)
# Prefer GOOGLE_API_KEY only — do not also set GEMINI_API_KEY to a different single key
# (google-genai may prefer one env var and ignore the pool).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=text-embedding-004
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
XAI_API_KEY=
GROK_MODEL=grok-4.6

# --- Search ---
TAVILY_API_KEY=

# --- Infra ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kiln
POSTGRES_USER=kiln
POSTGRES_PASSWORD=kiln_dev_password
DATABASE_URL=postgresql://kiln:kiln_dev_password@localhost:5432/kiln
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kiln_evidence

# --- Agent budget ---
# Dig further needs leftover iterations/tool calls after the first HITL pass.
# With 12/3 the first pass often exhausts the budget and Dig further stays locked
# (unless revise headroom is granted). Prefer deeper defaults for research quality.
MAX_TOOL_CALLS=24
MAX_INPUT_TOKENS=80000
MAX_ITERATIONS=5

AGENT_BASE_URL=http://localhost:8000
API_PORT=3000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth: clerk | dev | disabled
# Production must use clerk unless ALLOW_DEV_AUTH=true (local Docker images set NODE_ENV=production).
AUTH_MODE=dev
ALLOW_DEV_AUTH=true
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_AUTH_MODE=dev

# Service-to-service only (never for browsers)
API_SHARED_KEY=
API_TO_AGENT_KEY=
AGENT_SHARED_KEY=

# Stripe billing (test mode keys for local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

VITE_API_URL=
AGENT_STREAM_IDLE_TIMEOUT_MS=120000
OUTBOX_POLL_INTERVAL_MS=500
RESEARCH_JOB_ATTEMPTS=4

OTEL_EXPORTER_OTLP_ENDPOINT=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kiln

# Copy to retry.env in this folder. Do NOT commit retry.env.
# Used by retry-launch.ps1 (overnight A1 capacity retry on Windows).

# From: Oracle Console → Profile → Tenancy → copy OCID
# Or use compartment root (same as tenancy for free accounts).
COMPARTMENT_OCID=ocid1.compartment.oc1..aaaa...

# From: oci iam availability-domain list
# Example: bgXk:AP-TOKYO-1-AD-1
AVAILABILITY_DOMAIN=your-region-AD-1

# Public subnet OCID (must allow public IP — prohibitPublicIpOnVnic=false)
SUBNET_OCID=ocid1.subnet.oc1..aaaa...

# Ubuntu ARM image for A1. Run collect-ocids.ps1 to print candidates.
IMAGE_OCID=ocid1.image.oc1..aaaa...

# Path to your SSH *public* key (used at instance launch)
SSH_PUBLIC_KEY_FILE=C:\Users\ADMIN\.ssh\id_ed25519.pub

# Instance settings
DISPLAY_NAME=kiln
OCPUS=2
MEMORY_GB=12
BOOT_VOLUME_GB=50

# Retry: seconds between attempts (60–120 avoids API throttling)
RETRY_INTERVAL_SEC=90

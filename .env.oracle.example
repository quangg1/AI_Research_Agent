# Copy to .env on the Oracle VM. Do not commit .env.
# Replace DOMAIN, ACME_EMAIL, GOOGLE_API_KEY, AGENT_SHARED_KEY.

DOMAIN=yourname.io.vn
ACME_EMAIL=you@example.com

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=text-embedding-004

AUTH_MODE=dev
ALLOW_DEV_AUTH=true
VITE_AUTH_MODE=dev
# Empty = browser calls same origin (/v1 via nginx). Do not set this to the API container.
VITE_API_URL=
CORS_ORIGINS=https://yourname.io.vn

# openssl rand -hex 32
AGENT_SHARED_KEY=
API_TO_AGENT_KEY=

TAVILY_API_KEY=

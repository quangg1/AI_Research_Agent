# --- LLM ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=text-embedding-004
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Search ---
TAVILY_API_KEY=

# --- Infra ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kiln
POSTGRES_USER=kiln
POSTGRES_PASSWORD=kiln_dev_password
DATABASE_URL=postgresql://kiln:kiln_dev_password@localhost:5432/kiln
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kiln_evidence

MAX_TOOL_CALLS=12
MAX_INPUT_TOKENS=80000
MAX_ITERATIONS=3

AGENT_BASE_URL=http://localhost:8000
API_PORT=3000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Use disabled only for local development. Production refuses disabled auth.
AUTH_MODE=key
# Required whenever AUTH_MODE is not disabled.
API_SHARED_KEY=
# Shared only between the Nest API and agent internal endpoint.
API_TO_AGENT_KEY=
AGENT_SHARED_KEY=
VITE_API_URL=
AGENT_STREAM_IDLE_TIMEOUT_MS=120000
OUTBOX_POLL_INTERVAL_MS=500
RESEARCH_JOB_ATTEMPTS=4

OTEL_EXPORTER_OTLP_ENDPOINT=
# Set true, or leave false — agent enables tracing automatically when LANGCHAIN_API_KEY is present.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kiln
